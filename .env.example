# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only privileged key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only AI providers
GROQ_API_KEY=
CAPTURE_GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice-to-ledger limits
AI_MAX_AUDIO_BYTES=10485760
AI_PROVIDER_TIMEOUT_MS=18000

# Private-document extraction. Defaults match the current official multimodal
# APIs and can be overridden without changing application code.
DOCUMENT_OPENAI_MODEL=gpt-5-mini
DOCUMENT_GEMINI_MODEL=gemini-3.7-flash
DOCUMENT_GROQ_MODEL=qwen/qwen3.6-27b
DOCUMENT_AI_TIMEOUT_MS=20000
