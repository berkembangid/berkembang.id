# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only privileged key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only AI providers (at least one is required for AI capture processing)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional audio limit; defaults to 10485760 bytes (10 MiB)
AI_MAX_AUDIO_BYTES=10485760

# Optional per-provider timeout for a background attempt; defaults to 18000 ms
AI_PROVIDER_TIMEOUT_MS=18000
